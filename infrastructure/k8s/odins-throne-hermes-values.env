# Odin's Throne Hermes — sandbox dispatch values.
# Consumed by the pack's dispatch/fire-next-up skills when spawning agent
# sandbox Jobs for this repo, so dispatches don't need inline env overrides.
# Resolution order: $PACK_NAMESPACE env > .claude/agents-namespace > <repo>-agents.
PACK_NAMESPACE=odins-throne-hermes-agents
PACK_PROJECT=odins-throne-hermes
PACK_REPO_URL=https://github.com/declanshanaghy/odins-throne-hermes.git
PACK_IMAGE=us-central1-docker.pkg.dev/fenrir-ledger-prod/fenrir-images/agent-sandbox
PACK_SECRET_NAME=agent-secrets
